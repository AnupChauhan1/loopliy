# Local PostgreSQL (keep these values in sync with docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-local-password"
POSTGRES_DB="epatang_erp"
DATABASE_URL="postgresql://postgres:replace-with-a-local-password@localhost:5432/epatang_erp?schema=public"

# JWT
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Admin account password (required when running npm run prisma:seed)
ADMIN_PASSWORD="replace-with-a-unique-admin-password"

# Set to "true" only to seed sample/demo data (fake staff, clients, projects,
# the public demo org, etc.). Leave unset for a clean production database.
SEED_DEMO_DATA=""

# One-time purge of seeded business data on API boot (users/roles/config are
# preserved; runs only once thanks to a SystemState marker). Set to "true",
# deploy once, then it is safe to remove.
PURGE_SEED_DATA=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
API_BASE_URL="http://localhost:3001"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""

# Social Media Integrations
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""

# AI Integration (OpenAI)
OPENAI_API_KEY=""

# WebRTC / Media Server
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Environment
NODE_ENV="development"
