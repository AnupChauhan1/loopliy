# Local PostgreSQL (keep these values in sync with docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-local-password"
POSTGRES_DB="epatang_erp"
DATABASE_URL="postgresql://postgres:replace-with-a-local-password@localhost:5432/epatang_erp?schema=public"

# JWT
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Seeded demo accounts (required only when running npm run prisma:seed)
ADMIN_PASSWORD="replace-with-a-unique-admin-password"
STAFF_PASSWORD="replace-with-a-unique-staff-password"
CLIENT_PASSWORD="replace-with-a-unique-client-password"

# Isolated public demo tenant (public credentials must match the web values below)
DEMO_ADMIN_PASSWORD="replace-with-a-unique-demo-admin-password"
DEMO_MANAGER_PASSWORD="replace-with-a-unique-demo-manager-password"
DEMO_HR_PASSWORD="replace-with-a-unique-demo-hr-password"
DEMO_EMPLOYEE_PASSWORD="replace-with-a-unique-demo-employee-password"
DEMO_CLIENT_PASSWORD="replace-with-a-unique-demo-client-password"

# Public sandbox credentials shown on the login page; these users have synthetic data only
NEXT_PUBLIC_DEMO_ACCESS_ENABLED="true"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=""
NEXT_PUBLIC_DEMO_MANAGER_PASSWORD=""
NEXT_PUBLIC_DEMO_HR_PASSWORD=""
NEXT_PUBLIC_DEMO_EMPLOYEE_PASSWORD=""
NEXT_PUBLIC_DEMO_CLIENT_PASSWORD=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
API_BASE_URL="http://localhost:3001"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""

# Social Media Integrations
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""

# AI Integration (OpenAI)
OPENAI_API_KEY=""

# WebRTC / Media Server
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Environment
NODE_ENV="development"
