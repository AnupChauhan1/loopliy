// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Identity and Access
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  clients     Client[]
  projects    Project[]
  invoices    Invoice[]
  leads       Lead[]
  settings    OrganizationSettings?
  auditLogs   AuditLog[]
  departments Department[]
  modules     ModuleConfig[]
  announcements Announcement[]
  holidays    Holiday[]
  creativeRequests CreativeRequest[]
  videoRequests    VideoRequest[]
  issueTemplates  IssueTemplate[]
  issues          Issue[]
  attendanceSettings AttendanceSettings?
  attendanceSessions AttendanceSession[]
  attendanceCorrections AttendanceCorrection[]

  @@index([slug])
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatar            String?
  isActive          Boolean      @default(true)
  emailVerified     DateTime?
  approvedAt        DateTime?
  hrApprovedAt      DateTime?
  adminApprovedAt   DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  projectAccessStatus       String?
  projectAccessReason       String?
  projectAccessRequestedAt  DateTime?
  projectAccessDecidedAt    DateTime?
  emailVerifyToken  String?
  emailVerifyExpiresAt DateTime?
  resetToken        String?
  resetTokenExpiresAt DateTime?
  lastLoginAt       DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId      String?
  department        Department?   @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  teamId            String?
  team              Team?         @relation("TeamMember", fields: [teamId], references: [id], onDelete: SetNull)
  preferences       UserPreference?
  notifications     Notification[]
  announcements     Announcement[]
  headedDepartments Department[]   @relation("DepartmentHead")
  ledTeams          Team[]         @relation("TeamLead")

  memberships       Membership[]
  roles             UserRole[]
  tasks             TaskAssignee[]
  timeEntries       TimeEntry[]
  comments          TaskComment[]
  assignedProjects  ProjectMember[]
  ownedProjects     Project[]     @relation("ProjectOwner")
  meetings          MeetingParticipant[]
  messages          Message[]
  calls             CallParticipant[]
  callsInitiated    Call[]
  messageReads      MessageRead[]
  conversationMembers ConversationMember[]
  employeeProfile   EmployeeProfile?
  clientProfile     Client?         @relation("ClientPortalUser")
  attendanceRecords AttendanceRecord[]
  attendanceSessions AttendanceSession[]
  attendanceCorrectionsFor AttendanceCorrection[] @relation("AttendanceCorrectionSubject")
  attendanceCorrectionsSubmitted AttendanceCorrection[] @relation("AttendanceCorrectionRequester")
  attendanceCorrectionsReviewed AttendanceCorrection[] @relation("AttendanceCorrectionReviewer")
  creativeStrategyApprovals CreativeRequest[] @relation("CreativeStrategyApprover")
  creativeManagerApprovals CreativeRequest[] @relation("CreativeManagerApprover")
  creativeAssignedRequests CreativeRequest[] @relation("CreativeAssignee")
  creativeCreatedRequests CreativeRequest[] @relation("CreativeCreator")
  creativeApprovalEvents CreativeApprovalEvent[] @relation("CreativeApprovalActor")
  leaveRequests     LeaveRequest[]
  assignedIssues    Issue[]  @relation("IssueAssignee")
  createdIssues     Issue[]  @relation("IssueCreator")
  issueComments     IssueComment[]

  @@index([email])
  @@index([organizationId])
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  userRoles   UserRole[]

  @@index([name])
}

model Permission {
  id          String      @id @default(uuid())
  resource    String
  action      String
  description String?
  roles       Role[]      @relation("RolePermissions")
  createdAt   DateTime    @default(now())

  @@unique([resource, action])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@index([token])
}

// CRM and Sales
model Lead {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      String    @default("new")
  value       Float?
  assignedTo  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  followUps  FollowUp[]
  deals      Deal[]

  @@index([organizationId])
  @@index([status])
}

model Deal {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage       String    @default("prospecting")
  value       Float?
  expectedCloseDate DateTime?
  closeReason String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([stage])
}

model FollowUp {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([dueDate])
}

model Proposal {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  totalValue  Float
  status      String   @default("draft")
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model Contract {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  startDate DateTime
  endDate   DateTime?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// Clients and Projects
model Client {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  industry    String?
  website     String?
  status      String    @default("active")
  logo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portalUserId   String?   @unique
  portalUser     User?     @relation("ClientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)

  contacts    ClientContact[]
  services    ClientService[]
  projects    Project[]
  proposals   Proposal[]
  contracts   Contract[]
  invoices    Invoice[]
  conversations Conversation[]
  creativeRequests CreativeRequest[]

  @@index([organizationId])
  @@index([status])
}

model ClientContact {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientService {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active")
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("planning")
  priority    String   @default("medium")
  startDate   DateTime?
  deadline    DateTime?
  budget      Decimal? @db.Decimal(10, 2)
  estimatedHours Int?
  progress    Int      @default(0)
  section     String   @default("corporate") // corporate, it, facilities, template_set, floors, work
  clientName    String?
  projectType   String   @default("one_time") // recurring | one_time
  tenureUnit    String?  // days | weeks | months
  tenureValue   Int?
  planStructure String   @default("customised") // fixed | customised
  service       String?  // smm | website | seo | performance_ads | branding | other
  currentCycle  Int      @default(1)
  cycleStartDate DateTime?
  taskTemplate  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ownerId       String
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  members     ProjectMember[]
  tasks       Task[]
  milestones  Milestone[]
  deliverables Deliverable[]
  files       ProjectFile[]
  issues      Issue[]
  creativeRequests CreativeRequest[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([departmentId])
  @@index([section])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([dueDate])
}

model Deliverable {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("pending")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  tasks       Json
  milestones  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  url       String
  size      Int?
  mimeType  String?
  uploadedBy String
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Tasks and Time Tracking
model Task {
  id          String   @id @default(uuid())
  taskNumber  String?
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium")
  category    String?
  progress    Int      @default(0)
  requiresApproval Boolean @default(false)
  clientVisible Boolean @default(false)
  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?
  estimatedHours Int?
  actualHours   Int?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  moduleId    String?
  createdById String?
  organizationId String?
  isIndividual Boolean @default(false)
  isOverdue    Boolean @default(false)
  carriedForwardAt DateTime?
  dayOffset    Int?
  cycle        Int?
  workNote     String?
  deliverableUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees    TaskAssignee[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependsOn   TaskDependency[] @relation("DependsOnTask")
  comments     TaskComment[]
  attachments  TaskAttachment[]
  checklists   TaskChecklist[]
  timeEntries  TimeEntry[]
  statusHistory TaskStatusHistory[]

  @@index([projectId])
  @@index([status])
  @@index([deadline])
  @@index([organizationId])
}

model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task     @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            String   @default("finish_to_start")
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  url       String
  size      Int?
  mimeType  String?
  uploadedBy String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskChecklist {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model TimeEntry {
  id        String   @id @default(uuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime?
  /// Seconds of completed (non-paused) work; final total once stopped
  duration  Int?
  notes     String?
  /// running | paused | stopped — a user has at most one running/paused entry
  status       String    @default("stopped")
  /// Start of the current running segment (null while paused/stopped)
  segmentStart DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([startTime])
  @@index([userId, status])
}

model TaskStatusHistory {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([taskId])
}

// Social Media and Creative Approvals
model SocialAccount {
  id          String   @id @default(uuid())
  platform    String
  accountId   String
  accountName String
  accessToken String
  refreshToken String?
  tokenExpiry DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform])
  @@index([accountId])
}

model ContentPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  status      String   @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platforms   PostPlatform[]
  versions    PostVersion[]
  approvalRequests ApprovalRequest[]

  @@index([status])
  @@index([scheduledAt])
}

model PostPlatform {
  id          String   @id @default(uuid())
  postId      String
  post        ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    String
  caption     String?
  mediaUrls   Json?
  externalPostId String?
  publishStatus String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId])
  @@index([platform])
}

model PostVersion {
  id        String   @id @default(uuid())
  postId    String
  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  mediaUrls Json?
  createdAt DateTime @default(now())

  @@index([postId])
}

model MediaAsset {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String
  size      Int?
  mimeType  String?
  uploadedBy String
  createdAt DateTime @default(now())

  @@index([type])
}

model ApprovalRequest {
  id        String   @id @default(uuid())
  postId    String
  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  requestedBy String
  requestedAt DateTime @default(now())
  status    String   @default("pending")
  reviewedBy String?
  reviewedAt DateTime?
  comments  String?

  @@index([postId])
  @@index([status])
}

model ApprovalEvent {
  id          String   @id @default(uuid())
  approvalRequestId String
  action      String
  performedBy String
  comments    String?
  createdAt   DateTime @default(now())

  @@index([approvalRequestId])
}

model PublishJob {
  id          String   @id @default(uuid())
  postId      String
  platform    String
  scheduledAt DateTime
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

model PublishingLog {
  id        String   @id @default(uuid())
  jobId     String
  platform  String
  status    String
  response  Json?
  error     String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

// Communication
model Conversation {
  id        String   @id @default(uuid())
  name      String?
  type      String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ConversationMember[]
  messages  Message[]
  calls     Call[]

  @@index([clientId])
  @@index([type])
  @@index([projectId])
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String?
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  attachments    Json?
  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  pinnedAt       DateTime?
  replyToId      String?
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")
  reads          MessageRead[]
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

// Per-user read receipts for chat messages
model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model Call {
  id             String         @id @default(uuid())
  type           String
  status         String         @default("initiated")
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  initiatedById  String?
  initiatedBy    User?          @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  createdAt      DateTime       @default(now())

  participants   CallParticipant[]

  @@index([status])
  @@index([createdAt])
  @@index([conversationId])
}

model CallParticipant {
  id     String @id @default(uuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime?
  leftAt DateTime?

  @@unique([callId, userId])
  @@index([callId])
  @@index([userId])
}

model Meeting {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  link        String?
  status      String   @default("scheduled")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants MeetingParticipant[]

  @@index([startTime])
  @@index([status])
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("accepted")
  respondedAt DateTime?

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

// HR and Finance
model EmployeeProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId        String   @unique
  designation       String?
  reportingManager  String?
  dateOfJoining     DateTime?
  dateOfBirth       DateTime?
  gender            String?
  phone             String?
  address           String?
  emergencyContact  String?
  employmentStatus  String   @default("active")
  leaveBalance      Int      @default(20)
  salary            Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
}

model AttendanceSettings {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  officeStartTime        String   @default("10:30")
  officeEndTime          String   @default("19:00")
  gracePeriodMinutes     Int      @default(15)
  breakDeductionMinutes Int      @default(0)
  fullDayMinimumMinutes Int      @default(510)
  halfDayMinimumMinutes Int      @default(240)
  halfDaysPerDeduction   Int      @default(2)
  weeklyOffDays          String[] @default(["Sunday"])
  firstSaturdayOff       Boolean  @default(true)
  belowHalfDayStatus     String   @default("absent")
  overtimeMode           String   @default("after_shift_end")
  trackEarlyDeparture    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  totalHours Decimal? @db.Decimal(5, 2)
  status    String   @default("absent")
  lateMinutes Int    @default(0)
  earlyDepartureMinutes Int @default(0)
  overtimeMinutes Int @default(0)
  halfDay Boolean @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AttendanceSession[]
  corrections AttendanceCorrection[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model AttendanceSession {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordId           String
  record             AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn            DateTime
  checkOut           DateTime?
  checkInPhotoKey    String?
  checkOutPhotoKey   String?
  source             String   @default("punch")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, checkIn])
  @@index([recordId, checkIn])
  @@index([userId, checkOut])
}

model AttendanceCorrection {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  userId             String
  user               User     @relation("AttendanceCorrectionSubject", fields: [userId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        User     @relation("AttendanceCorrectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById       String?
  reviewedBy         User?    @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  date               DateTime
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             String   @default("pending")
  reviewNotes        String?
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([userId, date])
  @@index([attendanceRecordId])
}

model LeaveRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  startDate DateTime
  endDate   DateTime
  days      Int
  reason    String?
  status    String   @default("pending")
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceNumber String @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  amount      Float
  tax         Float
  total       Float
  dueDate     DateTime
  status      String   @default("draft")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items     InvoiceItem[]
  payments  Payment[]

  @@index([clientId])
  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity  Int
  unitPrice Float
  total     Float

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String?
  reference String?
  paidAt    DateTime @default(now())
  notes     String?

  @@index([invoiceId])
  @@index([paidAt])
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  category    String?
  date        DateTime
  receiptUrl  String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
}

model Retainer {
  id          String   @id @default(uuid())
  clientId    String
  amount      Float
  startDate   DateTime
  endDate     DateTime?
  billingCycle String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// System and Automation
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  types        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  trigger     String
  conditions  Json
  actions     Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model WorkflowRun {
  id         String   @id @default(uuid())
  ruleId     String
  status     String   @default("running")
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime @default(now())
  completedAt DateTime?

  @@index([ruleId])
  @@index([status])
}

model Integration {
  id        String   @id @default(uuid())
  name      String
  type      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model AuditLog {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String?
  action       String
  resource     String
  resourceId   String?
  changes      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  event     String
  payload   Json
  processed Boolean  @default(false)
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  processedAt DateTime?

  @@index([event])
  @@index([processed])
}

model BackgroundJob {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  status    String   @default("pending")
  attempts  Int      @default(0)
  error     String?
  scheduledAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([scheduledAt])
  @@index([type])
}

model OrganizationSettings {
  id                  String   @id @default(uuid())
  organizationId      String   @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timezone            String   @default("UTC")
  dateFormat          String   @default("YYYY-MM-DD")
  currency            String   @default("USD")
  taxRate             Float @default(0)
  logo                String?
  primaryColor        String   @default("#16A34A")
  brandName           String   @default("LOOPLY")
  soundEnabled        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
}

// Epatang — Departments, Teams and Modules
model Department {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  color          String   @default("#10b981")
  isArchived     Boolean  @default(false)
  headId         String?
  head           User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members        User[]        @relation("UserDepartment")
  teams          Team[]
  projects       Project[]
  tasks          Task[]
  creativeRequests CreativeRequest[]
  videoRequests    VideoRequest[]
  announcements  Announcement[]
  issueTemplates IssueTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([headId])
}

model Team {
  id             String   @id @default(uuid())
  name           String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members        User[] @relation("TeamMember")
  issues         Issue[] @relation("IssueTeam")

  @@index([departmentId])
  @@index([organizationId])
}

model ModuleConfig {
  id             String   @id @default(uuid())
  key            String
  name           String
  description    String?
  icon           String?
  roles          Json     @default("[]")
  departmentIds  Json     @default("[]")
  menuPosition   Int      @default(100)
  status         String   @default("active")
  fields         Json?
  permissions    Json?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([status])
}

// Creative (design) approval workflow
model CreativeRequest {
  id             String   @id @default(uuid())
  title          String
  brief          String?
  dimensions     String?
  format         String?
  creativeType   String   @default("graphic")
  campaign       String?
  sourceLink     String?
  requirements   String?
  submissionNotes String?
  status         String   @default("draft")
  priority       String   @default("medium")
  deadline       DateTime?
  referenceLinks Json?
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  taskId         String?
  createdById    String
  createdBy      User     @relation("CreativeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?    @relation("CreativeAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId     String?
  strategyApproverId String?
  strategyApprover User? @relation("CreativeStrategyApprover", fields: [strategyApproverId], references: [id], onDelete: SetNull)
  managerApproverId String?
  managerApprover User? @relation("CreativeManagerApprover", fields: [managerApproverId], references: [id], onDelete: SetNull)
  finalVersionId String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions       CreativeVersion[]
  approvalEvents CreativeApprovalEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([assigneeId])
  @@index([departmentId])
  @@index([strategyApproverId])
  @@index([managerApproverId])
  @@index([clientId])
  @@index([projectId])
}

model CreativeVersion {
  id           String   @id @default(uuid())
  requestId    String
  request      CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version      Int
  fileUrl      String?
  fileName     String?
  mimeType     String?
  size         Int?
  externalUrl  String?
  notes        String?
  status       String   @default("submitted")
  feedback     String?
  uploadedById String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  approvalEvents CreativeApprovalEvent[]

  @@unique([requestId, version])
  @@index([requestId])
  @@index([status])
}

model CreativeApprovalEvent {
  id        String   @id @default(uuid())
  requestId String
  request   CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  versionId String?
  version   CreativeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("CreativeApprovalActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  stage     String
  action    String
  message   String?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([versionId])
  @@index([actorId])
}

// Video approval workflow
model VideoRequest {
  id             String   @id @default(uuid())
  title          String
  brief          String?
  requirements   String?
  sourceLink     String?
  status         String   @default("brief")
  priority       String   @default("medium")
  deadline       DateTime?
  projectId      String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  taskId         String?
  createdById    String
  assigneeId     String?
  reviewerId     String?
  finalVersionId String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions       VideoVersion[]

  @@index([organizationId])
  @@index([status])
  @@index([assigneeId])
  @@index([departmentId])
}

model VideoVersion {
  id           String   @id @default(uuid())
  requestId    String
  request      VideoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version      Int
  fileUrl      String?
  fileName     String?
  mimeType     String?
  size         Int?
  externalUrl  String?
  duration     Int?
  notes        String?
  status       String   @default("submitted")
  feedback     String?
  uploadedById String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([requestId, version])
  @@index([requestId])
  @@index([status])
}

// Announcements & holidays
model Announcement {
  id             String   @id @default(uuid())
  title          String
  content        String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([departmentId])
}

model Holiday {
  id             String   @id @default(uuid())
  name           String
  date           DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([date])
}

// LOOPLY - Issue Management
model Issue {
  id              String   @id @default(uuid())
  title           String
  description     String?
  status          String   @default("open") // open, in_progress, ignore, closed
  priority        String   @default("medium") // low, medium, high, critical
  category        String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  templateId      String?
  template        IssueTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?    @relation("IssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team?    @relation("IssueTeam", fields: [teamId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User     @relation("IssueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  attachments     IssueAttachment[]
  comments        IssueComment[]
  activities      IssueActivity[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([dueDate])
}

model IssueTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  category        String?
  defaultPriority String   @default("medium")
  defaultStatus   String   @default("open")
  instructions    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  issues          Issue[]

  @@index([organizationId])
  @@index([isActive])
  @@index([departmentId])
}

model IssueAttachment {
  id          String   @id @default(uuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  name        String
  url         String
  size        Int?
  mimeType    String?
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([issueId])
}

model IssueComment {
  id          String   @id @default(uuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([issueId])
  @@index([userId])
}

model IssueActivity {
  id          String   @id @default(uuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  action      String   // created, updated, status_changed, assigned, commented, closed
  changedBy   String
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([issueId])
  @@index([createdAt])
}

// Per-user preferences (incl. completion sound)
model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundEnabled    Boolean  @default(true)
  soundVolume     Int      @default(70)
  submissionSound Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Tiny key/value store for one-time operational markers (e.g. seed-data purge)
model SystemState {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Email OTP challenges for signup verification (6-digit code, 10 min expiry)
model EmailOtp {
  id           String    @id @default(uuid())
  email        String    @unique
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  verifiedToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
